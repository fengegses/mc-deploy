# ============================================================
# 敏感配置
# ============================================================
# 使用方法：
#
#   方案 A（首次部署，手填）：
#     cp secrets.conf.example secrets.conf
#     nano secrets.conf
#
#   方案 B（迁移已有系统，自动抓取）：
#     cp secrets.conf.example secrets.conf
#     ./export.sh
#
# 注意：
#   - 所有值都用双引号包裹
#   - 空值表示"未设置"，export.sh 会尝试填充
#   - secrets.conf 永远不要提交到 Git
# ============================================================


# ---------- Cloudflare Tunnel ----------
# 方式一：Token 模式（推荐）
CF_TUNNEL_TOKEN=""

# 方式二：文件模式（以下值 export.sh 自动填充）
CF_ACCOUNT_TAG=""
CF_TUNNEL_ID=""
CF_TUNNEL_SECRET=""


# ---------- 域名 ----------
CF_DOMAIN=""
CF_HOSTNAME=""
CF_LOCAL_SERVICE=""


# ---------- RCON ----------
RCON_PASSWORD=""


# ---------- 服务器身份（可选） ----------
SERVER_OWNER=""
SERVER_EMAIL=""
SERVER_NAME=""
SERVER_DESCRIPTION=""
